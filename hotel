<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moonlight Bay Hotel</title>
    <style>
        /* --- CSS STYLING --- */
        :root {
            --dark-baby-blue: #4B8BBE; /* Darker baby blue */
            --light-blue: #89CFF0; /* Classic baby blue */
            --white: #FFFFFF;
            --dark-text: #333333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--white);
            color: var(--dark-text);
        }

        header {
            background-color: var(--dark-baby-blue);
            color: var(--white);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            margin: 0;
            font-size: 1.5rem;
        }

        nav {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        nav button {
            background: none;
            border: none;
            color: var(--white);
            font-size: 1rem;
            cursor: pointer;
            padding: 0.5rem;
            border-bottom: 2px solid transparent;
            transition: 0.3s;
        }

        nav button:hover, nav button.active {
            border-bottom: 2px solid var(--white);
            font-weight: bold;
        }

        main {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .page-section {
            display: none;
            animation: fadeIn 0.5s ease-in-out;
        }

        .page-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hero {
            background-color: var(--light-blue);
            padding: 4rem 2rem;
            text-align: center;
            border-radius: 8px;
            color: var(--dark-text);
        }

        button.primary {
            background-color: var(--dark-baby-blue);
            color: var(--white);
            border: none;
            padding: 10px 20px;
            font-size: 1.1rem;
            border-radius: 5px;
            cursor: pointer;
        }

        button.primary:hover {
            background-color: #3a6a96;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .card {
            border: 1px solid #ccc;
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
        }

        /* Forms */
        form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 400px;
            margin: 0 auto;
            background: #f9f9f9;
            padding: 2rem;
            border-radius: 8px;
            border: 1px solid var(--dark-baby-blue);
        }

        input, select {
            padding: 8px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .hidden { display: none; }
    </style>
</head>
<body>

    <header>
        <h1>🌙 Moonlight Bay Hotel</h1>
        <nav id="navbar">
            <button class="active" onclick="showSection('home')">Home</button>
            <button onclick="showSection('rooms')">Rooms</button>
            <button onclick="showSection('book')">Book</button>
            <button onclick="showSection('amenities')">Amenities</button>
            <button onclick="showSection('account')">Guest Account</button>
            <button onclick="showSection('admin')">Admin</button>
        </nav>
    </header>

    <main>
        <!-- HOME SECTION -->
        <section id="home" class="page-section active">
            <div class="hero">
                <h2>Welcome to Moonlight Bay</h2>
                <p>Experience the ultimate virtual getaway.</p>
                <button class="primary" onclick="showSection('book')">Book Your Stay</button>
            </div>
            <div class="card-grid">
                <div class="card">
                    <h3>Virtual Experience</h3>
                    <p>Explore our lobby, find hidden secrets, and play mini-games right from your browser.</p>
                </div>
                <div class="card">
                    <h3>Moon Points Loyalty</h3>
                    <p>Earn points for every virtual night you stay and unlock special room surprises.</p>
                </div>
            </div>
        </section>

        <!-- ROOMS SECTION -->
        <section id="rooms" class="page-section">
            <h2>Our Rooms & Suites</h2>
            <div class="card-grid">
                <div class="card">
                    <h3>Standard Ocean View</h3>
                    <p>$150 / night</p>
                    <p>Perfect for solo travelers or couples.</p>
                </div>
                <div class="card">
                    <h3>Deluxe Family Suite</h3>
                    <p>$300 / night</p>
                    <p>Spacious, with interactive TV and mini-game console.</p>
                </div>
            </div>
        </section>

        <!-- BOOKING SECTION -->
        <section id="book" class="page-section">
            <h2 style="text-align: center;">Make a Reservation</h2>
            <form id="bookingForm">
                <label>Room Type</label>
                <select id="roomSelect" onchange="calculatePrice()">
                    <option value="150">Standard Ocean View ($150/n)</option>
                    <option value="300">Deluxe Family Suite ($300/n)</option>
                </select>

                <label>Check-in Date</label>
                <input type="date" id="checkin" onchange="calculatePrice()" required>

                <label>Check-out Date</label>
                <input type="date" id="checkout" onchange="calculatePrice()" required>

                <label>Adults</label>
                <input type="number" id="adults" min="1" value="1" required>

                <h3>Total Estimated Price: $<span id="totalPrice">0</span></h3>
                
                <button type="submit" class="primary">Confirm Reservation</button>
            </form>
            <div id="bookingConfirmation" class="hidden" style="text-align: center; margin-top: 2rem; color: green;">
                <h3>Reservation Confirmed!</h3>
                <p>Your details have been saved to your browser.</p>
            </div>
        </section>

        <!-- AMENITIES SECTION -->
        <section id="amenities" class="page-section">
            <h2>Amenities & Activities</h2>
            <ul>
                <li><strong>Dining:</strong> 5-star virtual buffet with 3D models of food.</li>
                <li><strong>Pool:</strong> Ambient water sounds and relaxing lounge chairs.</li>
                <li><strong>FAQ Assistant:</strong> Ask our automated front desk bot anything.</li>
            </ul>
        </section>

        <!-- GUEST ACCOUNT SECTION -->
        <section id="account" class="page-section">
            <h2>Guest Account</h2>
            <div id="guestProfile" class="hidden">
                <h3 id="welcomeMessage"></h3>
                <p>Role: <span style="color: var(--dark-baby-blue); font-weight: bold;">Guest</span></p>
                <p>Moon Points: <strong>500</strong></p>
                <button class="primary" onclick="logout()">Sign Out</button>
            </div>
            <form id="loginForm">
                <p><em>(Simulation: Real version requires Firebase Auth)</em></p>
                <label>Enter your Display Name:</label>
                <input type="text" id="username" required>
                <button type="submit" class="primary">Create / Login</button>
            </form>
        </section>

        <!-- ADMIN SECTION -->
        <section id="admin" class="page-section">
            <h2>Admin Panel</h2>
            <div id="adminLogin">
                <p>Enter Roleplay Admin Code to access reservations.</p>
                <input type="password" id="adminCode" placeholder="Enter code...">
                <button class="primary" onclick="verifyAdmin()">Unlock</button>
                <p id="adminError" class="hidden" style="color: red;">Incorrect Code.</p>
            </div>
            <div id="adminDashboard" class="hidden">
                <h3 style="color: green;">Access Granted</h3>
                <p>Welcome, Manager. Here are the current saved reservations from LocalStorage:</p>
                <ul id="adminReservationList"></ul>
                <button class="primary" onclick="clearReservations()">Clear All Data</button>
            </div>
        </section>

    </main>

    <script>
        /* --- JAVASCRIPT LOGIC --- */

        // 1. Navigation System
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
            // Remove active state from all nav buttons
            document.querySelectorAll('nav button').forEach(btn => btn.classList.remove('active'));
            
            // Show target section
            document.getElementById(sectionId).classList.add('active');
            
            // Highlight clicked button
            const clickedBtn = Array.from(document.querySelectorAll('nav button'))
                                    .find(btn => btn.getAttribute('onclick').includes(sectionId));
            if(clickedBtn) clickedBtn.classList.add('active');
        }

        // 2. Booking Engine & Live Price Calculation
        function calculatePrice() {
            const roomRate = parseInt(document.getElementById('roomSelect').value);
            const checkin = new Date(document.getElementById('checkin').value);
            const checkout = new Date(document.getElementById('checkout').value);
            
            let days = 0;
            if (checkin && checkout && checkout > checkin) {
                const diffTime = Math.abs(checkout - checkin);
                days = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
            }
            
            const total = roomRate * days;
            document.getElementById('totalPrice').innerText = total > 0 ? total : 0;
        }

        // Save reservation to browser (LocalStorage)
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const res = {
                room: document.getElementById('roomSelect').options[document.getElementById('roomSelect').selectedIndex].text,
                checkin: document.getElementById('checkin').value,
                checkout: document.getElementById('checkout').value,
                price: document.getElementById('totalPrice').innerText
            };
            
            let allRes = JSON.parse(localStorage.getItem('hotel_reservations')) || [];
            allRes.push(res);
            localStorage.setItem('hotel_reservations', JSON.stringify(allRes));

            document.getElementById('bookingForm').classList.add('hidden');
            document.getElementById('bookingConfirmation').classList.remove('hidden');
        });

        // 3. Fictional Accounts System
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('username').value;
            localStorage.setItem('hotel_user', name);
            checkLogin();
        });

        function checkLogin() {
            const user = localStorage.getItem('hotel_user');
            if (user) {
                document.getElementById('loginForm').classList.add('hidden');
                document.getElementById('guestProfile').classList.remove('hidden');
                document.getElementById('welcomeMessage').innerText = `Welcome back, ${user}!`;
            }
        }

        function logout() {
            localStorage.removeItem('hotel_user');
            document.getElementById('loginForm').classList.remove('hidden');
            document.getElementById('guestProfile').classList.add('hidden');
        }

        // 4. Admin Panel & Security (Code: 5567)
        function verifyAdmin() {
            const code = document.getElementById('adminCode').value;
            if (code === '5567') {
                document.getElementById('adminLogin').classList.add('hidden');
                document.getElementById('adminDashboard').classList.remove('hidden');
                loadAdminData();
            } else {
                document.getElementById('adminError').classList.remove('hidden');
            }
        }

        function loadAdminData() {
            const list = document.getElementById('adminReservationList');
            list.innerHTML = '';
            let allRes = JSON.parse(localStorage.getItem('hotel_reservations')) || [];
            
            if (allRes.length === 0) {
                list.innerHTML = '<li>No reservations found.</li>';
                return;
            }

            allRes.forEach((res, index) => {
                let li = document.createElement('li');
                li.innerText = `Res #${index+1}: ${res.room} | In: ${res.checkin} | Out: ${res.checkout} | $${res.price}`;
                list.appendChild(li);
            });
        }

        function clearReservations() {
            localStorage.removeItem('hotel_reservations');
            loadAdminData();
        }

        // Initialize on load
        window.onload = function() {
            checkLogin();
        };
    </script>
</body>
</html>
