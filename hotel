<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moonlight Bay</title>
    <style>
        :root {
            --dark-baby-blue: #4B8BBE;
            --white: #FFFFFF;
            --bg-color: #f4f7f6;
            --text-color: #333;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-color);
        }

        header {
            background-color: var(--dark-baby-blue);
            color: var(--white);
            padding: 1.5rem;
            text-align: center;
        }

        nav {
            background-color: #3a6a96;
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 10px;
        }

        nav button {
            background: none;
            border: none;
            color: var(--white);
            font-size: 16px;
            cursor: pointer;
            padding: 5px 10px;
        }

        nav button:hover {
            text-decoration: underline;
            font-weight: bold;
        }

        main {
            padding: 20px;
            max-width: 800px;
            margin: 20px auto;
            background: var(--white);
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        button.primary {
            background-color: var(--dark-baby-blue);
            color: var(--white);
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 16px;
        }

        input {
            padding: 8px;
            margin: 5px 0 15px 0;
            width: 90%;
            display: block;
        }
    </style>
</head>
<body>

    <header>
        <h1>🌙 Moonlight Bay</h1>
    </header>

    <nav>
        <button onclick="switchTab('home')">Home</button>
        <button onclick="switchTab('book')">Book</button>
        <button onclick="switchTab('admin')">Admin</button>
    </nav>

    <main>
        <!-- HOME -->
        <div id="home" class="section active">
            <h2>Welcome to Moonlight Bay</h2>
            <p>Your premium virtual getaway is ready.</p>
        </div>

        <!-- BOOK -->
        <div id="book" class="section">
            <h2>Make a Reservation</h2>
            <label>Name:</label>
            <input type="text" id="guestName" placeholder="Enter your name">
            
            <label>Room/Flight Type:</label>
            <input type="text" id="roomType" placeholder="e.g., First Class / Suite">
            
            <button class="primary" onclick="saveBooking()">Confirm Booking</button>
            <p id="bookingStatus" style="color: green; display: none;">Booking saved successfully!</p>
        </div>

        <!-- ADMIN -->
        <div id="admin" class="section">
            <h2>Admin Panel</h2>
            <p>Enter code (5567) to view bookings.</p>
            <input type="password" id="adminCode">
            <button class="primary" onclick="checkAdmin()">Login</button>
            
            <div id="adminData" style="display: none; margin-top: 20px;">
                <h3 style="color: #4B8BBE;">Current Bookings:</h3>
                <ul id="bookingList"></ul>
                <button class="primary" onclick="clearData()" style="background: red;">Clear All</button>
            </div>
        </div>
    </main>

    <script>
        // Tab switching logic
        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
        }

        // Save booking to browser memory
        function saveBooking() {
            let name = document.getElementById('guestName').value;
            let room = document.getElementById('roomType').value;
            
            if(!name || !room) {
                alert("Please fill out both fields!");
                return;
            }

            let bookings = JSON.parse(localStorage.getItem('moonlight_data')) || [];
            bookings.push({ name: name, type: room });
            localStorage.setItem('moonlight_data', JSON.stringify(bookings));

            document.getElementById('bookingStatus').style.display = 'block';
            setTimeout(() => { document.getElementById('bookingStatus').style.display = 'none'; }, 3000);
        }

        // Admin logic
        function checkAdmin() {
            let code = document.getElementById('adminCode').value;
            if (code === '5567') {
                document.getElementById('adminData').style.display = 'block';
                loadBookings();
            } else {
                alert("Wrong code, bro.");
            }
        }

        function loadBookings() {
            let list = document.getElementById('bookingList');
            list.innerHTML = '';
            let bookings = JSON.parse(localStorage.getItem('moonlight_data')) || [];
            
            if(bookings.length === 0) {
                list.innerHTML = '<li>No bookings yet.</li>';
                return;
            }

            bookings.forEach(b => {
                let li = document.createElement('li');
                li.innerText = `${b.name} - ${b.type}`;
                list.appendChild(li);
            });
        }

        function clearData() {
            localStorage.removeItem('moonlight_data');
            loadBookings();
        }
    </script>
</body>
</html>
